# Database — PostgreSQL trên Supabase (xem docs/DATABASE.md)
# Dùng session pooler 5432; thay <project-ref> và <db-password> bằng thông tin được gửi riêng.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Phương án local (nếu không dùng Supabase):
# DATABASE_URL="postgresql://nola:mat-khau@localhost:5432/nola2hand"

# JWT — phải trùng với bản Node nếu muốn token cũ còn hiệu lực
JWT_SECRET="thay-bang-chuoi-bi-mat-cua-ban"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV="development"

# Frontend React khi chạy dev
CLIENT_URL="http://localhost:5173"
APP_URL="http://localhost:4000"

# Tuỳ chọn — thiếu thì dùng fallback cục bộ
# RESEND_API_KEY=
# MAIL_FROM="Nola2Hand <no-reply@your-domain.com>"
# Google login: thêm http://localhost:4000 và http://localhost:5173 vào
# Authorized JavaScript origins của OAuth client.
# GOOGLE_CLIENT_ID="<client-id>.apps.googleusercontent.com"
# OPENAI_API_KEY=
# OPENAI_MODEL=
AI_REVIEW_ANALYSIS="false"
